{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system-audio.contracts/v1",
  "title": "System Audio Auto Volume contracts",
  "oneOf": [
    {"$ref": "#/$defs/settings"},
    {"$ref": "#/$defs/state"},
    {"$ref": "#/$defs/action"},
    {"$ref": "#/$defs/peakGuardEvent"}
  ],
  "$defs": {
    "nullableLevel": {"type": ["number", "null"], "minimum": -120, "maximum": 20},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "mode", "preset", "triggerLufs", "targetLufs", "minSystemVolume", "maxSystemVolume", "lowerStepPercent", "lowerGain", "maxLowerDbPerSecond", "minLowerStepDb", "maxAutoAttenuationDb", "recoveryStepPercent", "lowerSustainSeconds", "sustainRatio", "recoverySustainSeconds", "recoveryPercentile", "recoveryHeadroomLu", "maxRaiseDbPerSecond", "recoveryCooldownSeconds", "songGapSeconds", "songHoldMaxSeconds", "fadeSlopeLuPerSecond", "manualOverrideSeconds", "silenceGateDbfs", "updatedAt"],
      "properties": {
        "schemaVersion": {"const": "system-audio.settings/v1"},
        "mode": {"enum": ["monitor", "shadow", "lower-only", "automatic"]},
        "preset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "comfortLufs", "sensitivity", "speed", "maxReductionDb"],
          "properties": {
            "mode": {"enum": ["simple", "custom"]},
            "comfortLufs": {"type": "number", "minimum": -70, "maximum": 0},
            "sensitivity": {"enum": ["low", "standard", "high"]},
            "speed": {"enum": ["gentle", "standard", "fast"]},
            "maxReductionDb": {"type": "number", "minimum": 1, "maximum": 40}
          }
        },
        "triggerLufs": {"type": "number", "minimum": -70, "maximum": 0},
        "targetLufs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "high"],
          "properties": {"low": {"type": "number"}, "high": {"type": "number"}}
        },
        "minSystemVolume": {"type": "number", "minimum": 0, "maximum": 100},
        "maxSystemVolume": {"type": "number", "minimum": 0, "maximum": 100},
        "lowerStepPercent": {"type": "number", "exclusiveMinimum": 0, "maximum": 20},
        "lowerGain": {"type": "number", "minimum": 0.1, "maximum": 1},
        "maxLowerDbPerSecond": {"type": "number", "minimum": 0.1, "maximum": 12},
        "minLowerStepDb": {"type": "number", "minimum": 0.1, "maximum": 3},
        "maxAutoAttenuationDb": {"type": "number", "minimum": 1, "maximum": 40},
        "recoveryStepPercent": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "lowerSustainSeconds": {"type": "number", "minimum": 0.25, "maximum": 60},
        "sustainRatio": {"type": "number", "minimum": 0.5, "maximum": 1},
        "recoverySustainSeconds": {"type": "number", "minimum": 0.5, "maximum": 300},
        "recoveryPercentile": {"type": "number", "minimum": 0.5, "maximum": 1},
        "recoveryHeadroomLu": {"type": "number", "minimum": 0, "maximum": 6},
        "maxRaiseDbPerSecond": {"type": "number", "minimum": 0.05, "maximum": 6},
        "recoveryCooldownSeconds": {"type": "number", "minimum": 0, "maximum": 600},
        "songGapSeconds": {"type": "number", "minimum": 0.5, "maximum": 30},
        "songHoldMaxSeconds": {"type": "number", "minimum": 30, "maximum": 1800},
        "fadeSlopeLuPerSecond": {"type": "number", "minimum": 0.05, "maximum": 5},
        "manualOverrideSeconds": {"type": "number", "minimum": 0, "maximum": 600},
        "silenceGateDbfs": {"type": "number", "minimum": -100, "maximum": -20},
        "updatedAt": {"type": "string", "minLength": 1}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "timestampMs", "platform", "simulated", "device", "measurement", "volume", "controller", "settings"],
      "properties": {
        "schemaVersion": {"const": "system-audio.state/v1"},
        "timestampMs": {"type": "number", "minimum": 0},
        "platform": {"type": "string"},
        "simulated": {"type": "boolean"},
        "device": {"type": "object"},
        "measurement": {"type": "object"},
        "volume": {"type": "object"},
        "controller": {"type": "object"},
        "settings": {"$ref": "#/$defs/settings"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "timestampMs", "state", "kind", "reason", "evidence", "beforeVolume", "recommendedVolume", "beforeVolumeDb", "recommendedVolumeDb", "recommendedAttenuationDb", "appliedVolume", "appliedVolumeDb", "execute", "mode", "controllerVersion", "settingsUpdatedAt"],
      "properties": {
        "schemaVersion": {"const": "system-audio.action/v1"},
        "timestampMs": {"type": "number", "minimum": 0},
        "state": {"type": "string"},
        "kind": {"type": "string"},
        "reason": {"type": "string"},
        "evidence": {"type": "object"},
        "beforeVolume": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "recommendedVolume": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "beforeVolumeDb": {"type": ["number", "null"], "minimum": -200, "maximum": 20},
        "recommendedVolumeDb": {"type": ["number", "null"], "minimum": -200, "maximum": 20},
        "recommendedAttenuationDb": {"type": ["number", "null"], "minimum": -60, "maximum": 12},
        "appliedVolume": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "appliedVolumeDb": {"type": ["number", "null"], "minimum": -200, "maximum": 20},
        "execute": {"type": "boolean"},
        "mode": {"enum": ["monitor", "shadow", "lower-only", "automatic"]},
        "controllerVersion": {"type": "string"},
        "settingsUpdatedAt": {"type": "string"},
        "eventWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["firstTimestampMs", "lastTimestampMs", "durationSeconds", "occurrences"],
          "properties": {
            "firstTimestampMs": {"type": "number", "minimum": 0},
            "lastTimestampMs": {"type": "number", "minimum": 0},
            "durationSeconds": {"type": "number", "minimum": 0, "maximum": 30},
            "occurrences": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "peakGuardEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "timestampMs", "kind", "state", "reason", "evidence", "suggestedAttenuationDb", "execute", "mode"],
      "properties": {
        "schemaVersion": {"const": "system-audio.peak-guard-event/v1"},
        "timestampMs": {"type": "number", "minimum": 0},
        "kind": {"const": "peak-guard"},
        "state": {"enum": ["ATTACK", "HOLD", "RELEASE", "ARMED"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "object"},
        "suggestedAttenuationDb": {"type": "number", "minimum": -12, "maximum": 0},
        "execute": {"const": false},
        "mode": {"const": "shadow"}
      }
    }
  }
}
