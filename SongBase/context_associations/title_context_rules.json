{
  "schema_version": "songbase.title-context-rules/v1",
  "rule_version": "2026-10-12.2",
  "scope": "song_title_only",
  "policy": {
    "approval": "candidates_only",
    "excluded_tags": ["weather.ice", "weather.dew", "holiday.graduation"],
    "auto_lock_allowed": false,
    "infer_lyrics_or_mood": false,
    "infer_season_from_month_or_weather": false,
    "infer_holiday_from_month": false,
    "infer_solar_term_from_weather": false,
    "infer_release_date_from_title_date": false,
    "annual_recurrence_default": "unset_requires_user_review",
    "empty_result_means": "本词表在标题中未发现关联，不代表歌曲内容没有情境关联。"
  },
  "categories": {
    "season": "四季",
    "weather": "天气与体感",
    "holiday": "节日与纪念情境",
    "calendar": "月份与日期",
    "solar_term": "二十四节气",
    "time_light": "时段与天光"
  },
  "normalization": {
    "unicode": "NFKC",
    "case": "casefold",
    "chinese_conversion": "仅转换词表涉及的常见繁体字，不声称完整繁简转换",
    "traditional_pairs": {"霧":"雾","風":"风","陰":"阴","陽":"阳","聖":"圣","誕":"诞","節":"节","驚":"惊","蟄":"蛰","滿":"满","處":"处","穀":"谷","曉":"晓","熱":"热","氣":"气","臘":"腊","週":"周","雲":"云","彌":"弥","憶":"忆","氷":"冰"},
    "credit_segments": "仅屏蔽 feat/ft/featuring 等明确合作艺人段",
    "version_segments": "仅屏蔽明确的 Live/Remix/Remaster/Explicit 等技术版本括号段；保留译名、Monsoon、Hey Oh 等内容括号"
  },
  "rules": [
    {"id":"season.spring","category":"season","label":"春季意象","match_mode":"mixed","aliases":["春天","春季","春日","之春","春に","春の","spring","printemps","primavera","frühling"],"strength":"explicit"},
